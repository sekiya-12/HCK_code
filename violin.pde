void draw() {
  background(0);
  stroke(255);
  for(int i = 0; i < out.bufferSize() - 1; i++) {
    line(i, 100 + out.left.get(i) * 50, i + 1, 100 + out.left.get(i + 1) * 50);
  }
}

// ==========================================
// 【ヴァイオリンのシンセサイザークラス】
// ==========================================
class ViolinInstrument implements Instrument {
  Oscil wave;        
  Oscil vibrato;     
  Noise bowNoise;    
  Summer mix;        
  MoogFilter filter; 
  ADSR ampEnv;       
  Line pitchSlide;   
  
  ViolinInstrument(float frequency, float amplitude) {
    // あなたが抽出した本物の波形をそのまま使います！
    wave = new Oscil(frequency, amplitude * 0.8, customViolinWave);
    
    // しゃくり上げ（ポルタメント）
    pitchSlide = new Line(0.15, frequency - 20, frequency);
    
    // ビブラート（揺らぎ）
    vibrato = new Oscil(6.0, frequency * 0.015, Waves.SINE); 
    pitchSlide.patch(vibrato.offset); 
    vibrato.patch(wave.frequency);
    
    // 弓の擦れ音（ノイズ）
    bowNoise = new Noise(amplitude * 0.05, Noise.Tint.WHITE);
    
    // 音をブレンド
    mix = new Summer();
    wave.patch(mix);
    bowNoise.patch(mix);
    
    // 木箱の響き（高音のキンキンを程よく抑える）
    filter = new MoogFilter(4000, 0.3, MoogFilter.Type.LP);
    mix.patch(filter);
    
    // 弓のタッチ（音の立ち上がりと消え方）
    ampEnv = new ADSR(1.0, 0.05, 0.1, 0.8, 0.2); 
    
    filter.patch(ampEnv);
  }

  void noteOn(float duration) {
    ampEnv.noteOn();
    pitchSlide.activate();
    ampEnv.patch(out);
  }

  void noteOff() {
    ampEnv.noteOff();
    ampEnv.unpatchAfterRelease(out);
  }
}
